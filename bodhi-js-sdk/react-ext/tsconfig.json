{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "dist",
    "types": ["vite/client", "vite-plugin-svgr/client", "chrome"],
    "paths": {
      "@bodhiapp/bodhi-js-react-core": ["../react-core/src/index.ts"],
      "@bodhiapp/bodhi-js-ext": ["../ext/src/index.ts"],
      "@bodhiapp/bodhi-js-core": ["../core/src/index.ts"],
      "@bodhiapp/bodhi-browser/types": ["../../bodhi-browser-ext/src/types"],
      "@bodhiapp/setup-modal/types": ["../../setup-modal/src/types"]
    }
  },
  "include": ["src/**/*", "../../bodhi-browser-ext/src/types/**/*", "../../setup-modal/src/types/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
