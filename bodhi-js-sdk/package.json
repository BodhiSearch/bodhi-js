{
  "name": "bodhi-js-sdk",
  "version": "0.0.1-dev",
  "private": true,
  "description": "Bodhi Browser SDK - TypeScript libraries for integrating with Bodhi Backend",
  "type": "module",
  "workspaces": [
    "core",
    "web",
    "ext",
    "react-core",
    "react",
    "react-ext"
  ],
  "scripts": {
    "build": "npm run build --workspaces && node scripts/fix-api-dts.cjs",
    "ci:build": "npm run ci:build --workspaces && node scripts/fix-api-dts.cjs",
    "dev:build": "npm run dev:build --workspaces && node scripts/fix-api-dts.cjs",
    "build:prod": "npm run build:prod --workspaces && node scripts/fix-api-dts.cjs",
    "clean": "npm run clean --workspaces",
    "lint": "prettier --check . && npm run lint --workspaces",
    "lint:fix": "prettier --write . && npm run lint:fix --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@bodhiapp/ts-client": "0.1.14",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.52.0",
    "@rollup/rollup-darwin-x64": "^4.52.0",
    "@rollup/rollup-linux-x64-gnu": "^4.52.0",
    "@rollup/rollup-linux-x64-musl": "^4.52.0",
    "@rollup/rollup-win32-x64-msvc": "^4.52.0",
    "lightningcss-darwin-arm64": "^1.30.1",
    "lightningcss-darwin-x64": "^1.30.1",
    "lightningcss-linux-x64-gnu": "^1.30.1",
    "lightningcss-linux-x64-musl": "^1.30.1",
    "lightningcss-win32-x64-msvc": "^1.30.1"
  },
  "keywords": [
    "bodhi",
    "llm",
    "browser",
    "sdk",
    "typescript"
  ],
  "author": "Bodhi Search",
  "license": "MIT"
}
