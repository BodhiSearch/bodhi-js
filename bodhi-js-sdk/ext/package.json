{
  "name": "@bodhiapp/bodhi-js-ext",
  "version": "0.0.34-dev",
  "description": "Extension SDK for Bodhi Browser - chrome.runtime communication",
  "type": "module",
  "main": "dist/bodhi-ext.cjs.js",
  "module": "dist/bodhi-ext.esm.js",
  "exports": {
    ".": {
      "types": "./dist/bodhi-ext.esm.d.ts",
      "import": "./dist/bodhi-ext.esm.js",
      "require": "./dist/bodhi-ext.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BodhiSearch/bodhi-js.git",
    "directory": "bodhi-js-sdk/ext"
  },
  "license": "MIT",
  "author": "BodhiSearch",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "vite build --mode development",
    "ci:build": "vite build --mode development",
    "dev:build": "node ../../scripts/build-fast.mjs bodhi-js-sdk/ext 'npm run build' src package.json vite.config.ts",
    "build:prod": "vite build --mode production",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx && prettier --check .",
    "lint:fix": "prettier --write . && eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bodhiapp/bodhi-browser-types": "file:../../bodhi-browser-ext/src/types",
    "@bodhiapp/bodhi-js-core": "file:../core",
    "@bodhiapp/ts-client": "0.1.29"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/chrome": "^0.0.281",
    "@types/node": "^20.19.10",
    "@typescript-eslint/eslint-plugin": "8.28.0",
    "@typescript-eslint/parser": "8.28.0",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^16.0.0",
    "prettier": "3.6.2",
    "rimraf": "^6.0.1",
    "tslib": "^2.6.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4"
  }
}
